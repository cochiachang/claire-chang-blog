<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/webp" href="/icon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Claire Chang｜企業 AI 導入與落地</title>
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Claire Chang" />
    <!-- 關掉手機瀏覽器把文章內容裡的數字自動轉成可點擊電話連結的行為——內文常出現年份、
         百分比、統計數字（19 年經驗、88+ 案例…），沒關掉常被 iOS Safari 誤判成電話號碼加底線。 -->
    <meta name="format-detection" content="telephone=no" />
    <link rel="alternate" type="application/rss+xml" title="Claire Chang｜企業 AI 導入與落地" href="/rss.xml" />

    <!--
      Critical CSS & Asset Preloading

      這裡要 preload 的是 hero-placeholder.webp，不是 hero-workshop-full.webp。
      實際的 LCP 元素是 Home.tsx 裡 loading=eager + fetchpriority=high 的
      .home2-hero-placeholder-img（首屏立刻蓋滿版面的模糊小圖），高畫質的
      hero-workshop-full.webp 要等 React mount 後才由 JS 觸發下載、且要三張都
      載完才淡入換掉 placeholder，不是首次繪製看到的那張圖。
      PageSpeed 的「LCP 要求探索」抓到的正是這個落差：preload 指到的檔案跟真正
      的 LCP 資源對不上，瀏覽器要等 JS 執行、React 把 <img> 插進 DOM 才會發現
      hero-placeholder.webp 這個請求，白白晚了一輪。改成 preload placeholder，
      讓瀏覽器在解析 <head> 時就直接開始抓這張圖。
    -->
    <link
      rel="preload"
      as="image"
      href="/images/site/hero-placeholder.webp"
      fetchpriority="high"
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <!--
      display=optional（不是 swap）：這個網站中文內文用 Noto Sans TC，字重跟後備字型
      （PingFang TC / Microsoft JhengHei）的字高、字寬差異很大，用 swap 會在字型下載完成
      後讓「幾乎整頁的文字」重新排版一次，越下面的元素被推移的距離越大——PageSpeed 手機版
      報告量到 footer 一個元素就吃掉 0.34 的 CLS，元凶正是這個 swap 造成的整頁重排。
      改成 optional：瀏覽器只會在極短時間內（多半是字型已被快取）就緒才使用 Noto Sans TC，
      沒趕上就整頁改用後備字型顯示到底，不會有「先上後備字型、再晚一步整頁重排成 Noto Sans TC」
      這個 CLS 來源。代價是沒快取的第一次造訪，中文內文可能顯示後備字型而非 Noto Sans TC，
      這個取捨對這裡的 CLS 分數是划算的。
    -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Noto+Sans+TC:wght@400;700&display=optional"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&family=Noto+Sans+TC:wght@400;700&display=optional"
      />
    </noscript>
    <script type="module" crossorigin src="/assets/index-Bpz9Txln.js"></script>
    <link rel="modulepreload" crossorigin href="/assets/rolldown-runtime-hePW80VL.js">
    <link rel="modulepreload" crossorigin href="/assets/vendor-react-CbYonmBs.js">
    <link rel="stylesheet" crossorigin href="/assets/index-DSxH6joZ.css">
  <meta name="description" content="19 年軟體工程背景，現為企業 AI 導入顧問。協助中小企業找出適合導入 AI 的工作流程，翻譯營運與技術需求，並透過客製化內訓與專案陪跑，讓 AI 真正進入日常工作。" />
<meta name="keywords" content="企業 AI 導入, AI 顧問, AI 落地, 中小企業 AI, AI 內訓, Claire Chang" />
